{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retentiq/events/order.created/v1",
  "title": "order.created",
  "description": "Emitido pelo serviço de pedidos. Consumido pelo read model de receita e pelo re-score de churn.",
  "type": "object",
  "required": ["event_id", "occurred_at", "order_id", "customer_id", "amount"],
  "properties": {
    "event_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "order_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "amount": { "type": "number", "minimum": 0 },
    "items": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
