erDiagram
    dim_country {
        integer country_id PK
        text country
    }
    dim_customer {
        integer customer_id PK
        text primary_country
    }
    dim_date {
        timestamp date
        integer date_id PK
        integer year
        integer month
        integer day
        text weekday
        integer is_weekend
    }
    dim_product {
        text stock_code PK
        text description
    }
    etl_load_audit {
        integer load_id PK
        text loaded_at_utc
