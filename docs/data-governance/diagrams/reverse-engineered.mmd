        integer dropped_duplicates
        integer dropped_invalid_sales
        integer fact_sales_rows
        integer fact_cancelled_rows
        real fact_sales_revenue
    }
    fact_sales {
        integer sale_id PK
        text invoice
        text stock_code FK
        integer customer_id FK
        integer country_id FK
        integer date_id FK
        timestamp invoice_date
        integer quantity
        real price
        real revenue
    }
    fact_sales_cancelled {
        integer cancel_id PK
        text invoice
        text stock_code
        integer customer_id
        integer country_id
        integer date_id
        timestamp invoice_date
        integer quantity
        real price
        real revenue
    }
    dim_country ||--o{ fact_sales : "country_id"
    dim_customer ||--o{ fact_sales : "customer_id"
