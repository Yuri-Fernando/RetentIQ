# RetentIQ API — variáveis de ambiente
# Copie para .env e preencha antes de rodar `npm run dev`.

PORT=4000
NODE_ENV=development

# Caminho do Data Warehouse SQLite gerado pelo pipeline Python
# (data-platform/ingestion/extract_transform_load.py)
WAREHOUSE_DB_PATH=../../data-platform/warehouse/retentiq.db
CHURN_SCORES_CSV_PATH=../../data-platform/warehouse/churn_scores.csv
DEMAND_FORECAST_CSV_PATH=../../data-platform/warehouse/demand_forecast.csv
# Usado pela rota GET /api/retention/recommendations/:customerId e pelo
# POST /api/retention/actions/:id/winback — se o script Python ainda não
# gerou esse CSV, as rotas devolvem [] em vez de erro.
CUSTOMER_RECOMMENDATIONS_CSV_PATH=../../data-platform/warehouse/customer_recommendations.csv

# --- PENDENTE (preencher antes de ir para produção — ver docs/HISTORICO.md) ---
# Segredo usado para assinar os JWTs. Gere um valor forte, ex.: `openssl rand -hex 32`.
JWT_SECRET=troque-este-valor-antes-de-usar-em-producao
JWT_EXPIRES_IN=8h

# Credenciais de demo do usuário admin (login local simplificado — trocar por uma
# tabela real de usuários + hash de senha (bcrypt/argon2) antes de produção real).
DEMO_ADMIN_EMAIL=admin@retentiq.dev
DEMO_ADMIN_PASSWORD=troque-esta-senha

# Redis é usado pelo rate limiter e pela fila de notificações quando a stack roda
# via docker-compose (infra/docker/docker-compose.yml). Em dev local sem Docker,
# o rate limiter cai automaticamente para armazenamento em memória.
REDIS_URL=redis://localhost:6379

# CORS — origem do frontend Next.js
WEB_ORIGIN=http://localhost:3000
